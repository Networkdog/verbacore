<ui:FluentWindow x:Class="VerbaCore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:VerbaCore.Views"
        mc:Ignorable="d"
        Title="VerbaCore"
        Width="520" Height="680"
        MinWidth="400" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <ui:TitleBar Grid.Row="0"
                     Title="VerbaCore"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True" />

        <!-- Tab Navigation -->
        <TabControl Grid.Row="1"
                    x:Name="MainTabControl"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Margin="0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="Padding" Value="16,8" />
                </Style>
            </TabControl.Resources>

            <TabItem Header="🔍 사전/번역">
                <views:MainView x:Name="MainViewPage" />
            </TabItem>

            <TabItem Header="📋 히스토리">
                <views:HistoryView x:Name="HistoryViewPage" />
            </TabItem>

            <TabItem Header="⚙ 설정">
                <views:SettingsView x:Name="SettingsViewPage" />
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
