<Window x:Class="VerbaCore.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VerbaCore Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Width="700" Height="400"
        ResizeMode="NoResize"
        Focusable="False">

    <Grid x:Name="RootGrid" Opacity="0">
        <!-- Semi-transparent backdrop -->
        <Border Background="#CC1A1A2E"
                CornerRadius="16"
                Margin="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="Black" />
            </Border.Effect>

            <Grid Margin="32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Mode indicator -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock x:Name="ModeLabel"
                               Text="📖 사전"
                               FontSize="13"
                               Foreground="#80FFFFFF"
                               VerticalAlignment="Center" />
                    <TextBlock Text="  ·  "
                               FontSize="13"
                               Foreground="#40FFFFFF"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LangLabel"
                               Text="EN → KO"
                               FontSize="13"
                               Foreground="#80FFFFFF"
                               VerticalAlignment="Center" />
                    <TextBlock Text="  ·  Tab: 모드 전환"
                               FontSize="11"
                               Foreground="#40FFFFFF"
                               VerticalAlignment="Center"
                               x:Name="HintLabel" />
                </StackPanel>

                <!-- Input text (large, Enso-style) -->
                <TextBlock Grid.Row="1"
                           x:Name="InputDisplay"
                           Text=""
                           FontSize="36"
                           FontWeight="Light"
                           Foreground="White"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <!-- Blinking cursor -->
                <Border Grid.Row="1"
                        x:Name="BlinkingCursor"
                        Width="2" Height="40"
                        Background="White"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,8"
                        Opacity="0.8" />

                <!-- Result area (appears after CapsLock release) -->
                <FlowDocumentScrollViewer Grid.Row="2"
                              x:Name="ResultViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed"
                              Margin="0,8,0,0"
                              Background="Transparent"
                              Foreground="#E0FFFFFF"
                              FontSize="14"
                              FontFamily="Segoe UI"
                              IsToolBarVisible="False" />

                <!-- Loading indicator -->
                <StackPanel Grid.Row="2"
                            x:Name="LoadingPanel"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="⏳"
                               FontSize="24"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="조회 중..."
                               FontSize="13"
                               Foreground="#80FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>

                <!-- Status -->
                <TextBlock Grid.Row="3"
                           x:Name="StatusLabel"
                           Text="CapsLock을 누른 채로 단어를 입력하세요"
                           FontSize="11"
                           Foreground="#50FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>