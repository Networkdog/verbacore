<Window x:Class="VerbaCore.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VerbaCore Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Width="800" Height="600"
        ResizeMode="NoResize"
        Focusable="True">

    <Grid x:Name="RootGrid">
        <!-- Semi-transparent backdrop -->
        <Border Background="#CC1A1A1A"
                CornerRadius="16"
                Margin="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="Black" />
            </Border.Effect>

            <Grid Margin="32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Mode indicator -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock x:Name="ModeLabel"
                               Text="📖 사전"
                               FontSize="15"
                               FontFamily="{StaticResource AppUIFont}"
                               Foreground="#80FFFFFF"
                               VerticalAlignment="Center" />
                    <TextBlock Text="  ·  "
                               FontSize="15"
                               FontFamily="{StaticResource AppUIFont}"
                               Foreground="#40FFFFFF"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LangLabel"
                               Text="EN → KO"
                               FontSize="15"
                               FontFamily="{StaticResource AppUIFont}"
                               Foreground="#80FFFFFF"
                               VerticalAlignment="Center" />
                    <TextBlock Text="  ·  Tab: 모드 전환"
                               FontSize="15"
                               FontFamily="{StaticResource AppUIFont}"
                               Foreground="#40FFFFFF"
                               VerticalAlignment="Center"
                               x:Name="HintLabel" />
                </StackPanel>

                <!-- Input text (large, Enso-style) - for long-press mode -->
                <TextBlock Grid.Row="1"
                           x:Name="InputDisplay"
                           Text=""
                           FontSize="72"
                           FontWeight="Light"
                           FontFamily="{StaticResource AppContentFont}"
                           Foreground="White"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="220"
                           Margin="0,0,0,8" />

                <!-- IME-enabled input for persistent (quick-tap) mode - supports Korean -->
                <TextBox Grid.Row="1"
                         x:Name="InputTextBox"
                         FontSize="64"
                         FontWeight="Light"
                         FontFamily="{StaticResource AppContentFont}"
                         Foreground="White"
                         CaretBrush="White"
                         SelectionBrush="#5500AAFF"
                         Margin="0,0,0,8"
                         Visibility="Collapsed"
                         AcceptsReturn="False"
                         TextWrapping="Wrap"
                         MaxHeight="220"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Background="Transparent"
                                                      Focusable="False" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Blinking cursor (Enso mode only) -->
                <Border Grid.Row="1"
                        x:Name="BlinkingCursor"
                        Width="3" Height="80"
                        Background="White"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,8"
                        Opacity="0.8" />

                <!-- Result area (appears after CapsLock release) -->
                <FlowDocumentScrollViewer Grid.Row="2"
                              x:Name="ResultViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed"
                              Margin="0,8,0,0"
                              Background="Transparent"
                              Foreground="#E0FFFFFF"
                              FontSize="16"
                              FontFamily="{StaticResource AppContentFont}"
                              FontWeight="Regular"
                              IsToolBarVisible="False" />

                <!-- Loading indicator -->
                <StackPanel Grid.Row="2"
                            x:Name="LoadingPanel"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <Storyboard x:Key="SpinnerStoryboard">
                            <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" To="360"
                                             Duration="0:0:1"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </StackPanel.Resources>
                    <!-- Rotating arc spinner -->
                    <Ellipse Width="44" Height="44"
                             StrokeThickness="3"
                             Stroke="#B0FFFFFF"
                             StrokeDashArray="2.5 5"
                             StrokeDashCap="Round"
                             HorizontalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation" Angle="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </StackPanel>

                <!-- Status -->
                <TextBlock Grid.Row="3"
                           x:Name="StatusLabel"
                           Text="CapsLock을 누른 채로 단어를 입력하세요"
                           FontSize="15"
                           FontFamily="{StaticResource AppUIFont}"
                           Foreground="#50FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>