<Window x:Class="VerbaCore.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VerbaCore Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Width="800" Height="600"
        ResizeMode="NoResize"
        Focusable="True">

    <Grid x:Name="RootGrid">
        <!-- Semi-transparent backdrop with subtle gradient -->
        <Border x:Name="ContentBorder"
                CornerRadius="16"
                Margin="20"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="ContentTranslate" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#CC1A1A2E" Offset="0" />
                    <GradientStop Color="#CC141420" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" Color="#000020" />
            </Border.Effect>

            <!-- Inner border for subtle edge highlight -->
            <Border CornerRadius="15"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="1"
                    Padding="0">

            <Grid Margin="32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Mode indicator -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Background="#20FFFFFF" CornerRadius="8" Padding="10,4">
                        <TextBlock x:Name="ModeLabel"
                                   Text="📖 사전"
                                   FontSize="14"
                                   FontFamily="{StaticResource AppUIFont}"
                                   Foreground="#B0FFFFFF"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="  ·  "
                               FontSize="14"
                               FontFamily="{StaticResource AppUIFont}"
                               Foreground="#30FFFFFF"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LangLabel"
                               Text="EN → KO"
                               FontSize="14"
                               FontFamily="{StaticResource AppUIFont}"
                               Foreground="#70FFFFFF"
                               VerticalAlignment="Center" />
                    <TextBlock Text="  ·  Tab: 모드 전환"
                               FontSize="13"
                               FontFamily="{StaticResource AppUIFont}"
                               Foreground="#35FFFFFF"
                               VerticalAlignment="Center"
                               x:Name="HintLabel" />
                </StackPanel>

                <!-- Input text (large, Enso-style) - for long-press mode -->
                <TextBlock Grid.Row="1"
                           x:Name="InputDisplay"
                           Text=""
                           FontSize="72"
                           FontWeight="Light"
                           FontFamily="{StaticResource AppContentFont}"
                           Foreground="White"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="220"
                           Margin="0,0,0,8" />

                <!-- IME-enabled input for persistent (quick-tap) mode - supports Korean -->
                <TextBox Grid.Row="1"
                         x:Name="InputTextBox"
                         FontSize="64"
                         FontWeight="Light"
                         FontFamily="{StaticResource AppContentFont}"
                         Foreground="White"
                         CaretBrush="White"
                         SelectionBrush="#5500AAFF"
                         Margin="0,0,0,8"
                         Visibility="Collapsed"
                         AcceptsReturn="False"
                         TextWrapping="Wrap"
                         MaxHeight="220"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Background="Transparent"
                                                      Focusable="False" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Blinking cursor (Enso mode only) -->
                <Border Grid.Row="1"
                        x:Name="BlinkingCursor"
                        Width="3" Height="80"
                        Background="White"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,8"
                        Opacity="0.8" />

                <!-- Result area (appears after CapsLock release) -->
                <FlowDocumentScrollViewer Grid.Row="2"
                              x:Name="ResultViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed"
                              Opacity="0"
                              Margin="0,8,0,0"
                              Background="Transparent"
                              Foreground="#E0FFFFFF"
                              FontSize="16"
                              FontFamily="{StaticResource AppContentFont}"
                              FontWeight="Regular"
                              IsToolBarVisible="False" />

                <!-- Loading indicator -->
                <StackPanel Grid.Row="2"
                            x:Name="LoadingPanel"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <Storyboard x:Key="SpinnerStoryboard">
                            <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" To="360"
                                             Duration="0:0:0.9"
                                             RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SpinnerEllipse"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.5" To="1.0"
                                             Duration="0:0:0.8"
                                             AutoReverse="True"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </StackPanel.Resources>
                    <!-- Rotating arc spinner -->
                    <Ellipse x:Name="SpinnerEllipse"
                             Width="36" Height="36"
                             StrokeThickness="2.5"
                             Stroke="#90FFFFFF"
                             StrokeDashArray="3 4"
                             StrokeDashCap="Round"
                             HorizontalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation" Angle="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock Text="조회 중..."
                               FontSize="13"
                               FontFamily="{StaticResource AppUIFont}"
                               Foreground="#60FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0" />
                </StackPanel>

                <!-- Status -->
                <TextBlock Grid.Row="3"
                           x:Name="StatusLabel"
                           Text="CapsLock을 누른 채로 단어를 입력하세요"
                           FontSize="13"
                           FontFamily="{StaticResource AppUIFont}"
                           Foreground="#40FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0" />
            </Grid>
            </Border>
        </Border>
    </Grid>
</Window>