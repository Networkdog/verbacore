<Application x:Class="VerbaCore.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:VerbaCore.Helpers"
             xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
             ShutdownMode="OnExplicitShutdown"
             DispatcherUnhandledException="OnDispatcherUnhandledException">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="pack://application:,,,/Markdig.Wpf;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <helpers:ModeToAppearanceConverter x:Key="ModeToAppearanceConverter" />
            <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <helpers:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />
            <helpers:BoolToAzureKeyPlaceholderConverter x:Key="BoolToAzureKeyPlaceholderConverter" />

            <!-- App-wide font families (change here to update everywhere) -->
            <FontFamily x:Key="AppUIFont">Noto Sans KR, AppleSDGothicNeoL00, Segoe UI</FontFamily>
            <FontFamily x:Key="AppContentFont">Noto Sans Light, AppleSDGothicNeoL00, Segoe UI</FontFamily>
            <FontFamily x:Key="AppCodeFont">Cascadia Code, Consolas, monospace</FontFamily>

            <!-- Override Markdig.Wpf code styles: remove light gray background that
                 makes white text unreadable on the dark overlay.
                 NOTE: inline code is rendered by Markdig.Wpf as a <Run>, so this style
                 MUST target Run. Targeting Span throws InvalidOperationException at
                 render time ("'Span' TargetType does not match type of element 'Run'"),
                 which made every result containing inline code fall back to raw source. -->
            <Style x:Key="{x:Static markdig:Styles.CodeStyleKey}" TargetType="{x:Type Run}">
                <Setter Property="FontFamily" Value="{StaticResource AppCodeFont}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#FFE6B85C" />
            </Style>

            <Style x:Key="{x:Static markdig:Styles.CodeBlockStyleKey}" TargetType="{x:Type Paragraph}">
                <Setter Property="FontFamily" Value="{StaticResource AppCodeFont}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#FFE6B85C" />
                <Setter Property="Margin" Value="0,4,0,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
