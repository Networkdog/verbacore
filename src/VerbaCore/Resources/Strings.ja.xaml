    <sys:String x:Key="Position_CenterLeft">左中央</sys:String>
    <sys:String x:Key="Position_Center">中央</sys:String>
    <sys:String x:Key="Position_CenterRight">右中央</sys:String>
    <sys:String x:Key="Position_BottomLeft">左下</sys:String>
    <sys:String x:Key="Position_BottomCenter">下中央</sys:String>
    <sys:String x:Key="Position_BottomRight">右下</sys:String>

