<UserControl x:Class="VerbaCore.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:VerbaCore.ViewModels"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Mode Selector + Language -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Mode Buttons -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <ui:Button Content="📖 사전"
                           Appearance="{Binding CurrentMode, Converter={StaticResource ModeToAppearanceConverter}, ConverterParameter=Dictionary}"
                           Command="{Binding SetModeCommand}"
                           CommandParameter="Dictionary"
                           Margin="0,0,4,0" />
                <ui:Button Content="🔄 번역"
                           Appearance="{Binding CurrentMode, Converter={StaticResource ModeToAppearanceConverter}, ConverterParameter=Translate}"
                           Command="{Binding SetModeCommand}"
                           CommandParameter="Translate" />
            </StackPanel>

            <!-- Language Swap -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding SupportedLanguages}"
                          SelectedItem="{Binding SourceLanguage}"
                          MinWidth="90" Margin="0,0,4,0" />
                <ui:Button Content="⇄"
                           Command="{Binding SwapLanguagesCommand}"
                           Padding="8,4"
                           ToolTip="언어 전환" />
                <ComboBox ItemsSource="{Binding SupportedLanguages}"
                          SelectedItem="{Binding TargetLanguage}"
                          MinWidth="90" Margin="4,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- Input Area -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="InputTextBox"
                        Grid.Column="0"
                        PlaceholderText="단어 또는 문장을 입력하세요..."
                        Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                        AcceptsReturn="False"
                        VerticalContentAlignment="Center"
                        FontSize="14"
                        Margin="0,0,4,0"
                        KeyDown="InputTextBox_KeyDown" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="🎤"
                           Command="{Binding ToggleSpeechCommand}"
                           ToolTip="음성 입력 (토글)"
                           Padding="10,8"
                           Margin="0,0,2,0">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListening}" Value="True">
                                    <Setter Property="Background" Value="#FF4444" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Content="🖱"
                           Command="{Binding GrabCursorTextCommand}"
                           ToolTip="커서 아래 텍스트 가져오기"
                           Padding="10,8" />
            </StackPanel>
        </Grid>

        <!-- Lookup Button -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <ui:Button Content="조회"
                       Appearance="Primary"
                       Command="{Binding LookupCommand}"
                       HorizontalAlignment="Stretch"
                       FontSize="14"
                       Padding="0,10"
                       IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" />
            <ui:Button Content="취소"
                       Appearance="Danger"
                       Command="{Binding CancelLookupCommand}"
                       HorizontalAlignment="Right"
                       Padding="16,10"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

        <!-- Result Area -->
        <Border Grid.Row="3"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,8">
            <Grid>
                <!-- Loading indicator -->
                <ui:ProgressRing IsIndeterminate="True"
                                 Width="32" Height="32"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Result text (Markdown-rendered FlowDocument) -->
                <FlowDocumentScrollViewer x:Name="ResultViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsToolBarVisible="False"
                                          Background="Transparent"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          FontSize="14"
                                          FontFamily="{StaticResource AppContentFont}" />
            </Grid>
        </Border>

        <!-- Status Bar -->
        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   FontSize="11"
                   Opacity="0.6"
                   Margin="4,0" />
    </Grid>
</UserControl>