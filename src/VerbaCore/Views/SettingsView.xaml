<UserControl x:Class="VerbaCore.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:VerbaCore.ViewModels"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8,16,16">
        <StackPanel Margin="0,0,0,16">

            <!-- API Settings -->
            <TextBlock Text="API 설정" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

            <ui:Card Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="API 제공자" Margin="0,0,0,4" FontSize="12" Opacity="0.7" />
                    <ComboBox ItemsSource="{Binding AvailableProviders}"
                              SelectedItem="{Binding SelectedProvider}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="API Key" Margin="0,0,0,4" FontSize="12" Opacity="0.7" />
                    <ui:PasswordBox Password="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{Binding IsAzure, Converter={StaticResource BoolToAzureKeyPlaceholderConverter}}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="모델" Margin="0,0,0,4" FontSize="12" Opacity="0.7" />
                    <ComboBox ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding SelectedModel}"
                              IsEditable="True"
                              Text="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="목록에서 선택하거나 직접 입력할 수 있습니다" FontSize="10" Opacity="0.5" Margin="0,4,0,0" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Reasoning Effort" FontSize="13" />
                        <TextBlock Text="GPT-5, o1, o3 등 reasoning 모델에서 사고 수준 조절" FontSize="10" Opacity="0.5" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableReasoningEfforts}"
                              SelectedItem="{Binding ReasoningEffort}"
                              MinWidth="100" />
                </Grid>
            </ui:Card>

            <!-- Azure OpenAI Settings -->
            <StackPanel Visibility="{Binding IsAzure, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:Card Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Azure Endpoint" Margin="0,0,0,4" FontSize="12" Opacity="0.7" />
                        <ui:TextBox Text="{Binding AzureEndpoint, Mode=TwoWay}"
                                    PlaceholderText="https://your-resource.openai.azure.com" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="API 버전" Margin="0,0,0,4" FontSize="12" Opacity="0.7" />
                        <ui:TextBox Text="{Binding AzureApiVersion, Mode=TwoWay}"
                                    PlaceholderText="2024-10-21" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <!-- Custom Endpoint Settings -->
            <StackPanel Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:Card Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Custom Endpoint" Margin="0,0,0,4" FontSize="12" Opacity="0.7" />
                        <ui:TextBox Text="{Binding CustomEndpoint, Mode=TwoWay}"
                                    PlaceholderText="http://localhost:11434 또는 https://your-server.com" />
                        <TextBlock Text="OpenAI 호환 API 엔드포인트 (Ollama, LM Studio 등)" FontSize="10" Opacity="0.5" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <!-- Input Settings -->
            <TextBlock Text="언어 설정" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12" />

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="모국어" FontSize="13" />
                        <TextBlock Text="해설과 번역 결과가 표시되는 언어" FontSize="10" Opacity="0.5" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding NativeLanguage}"
                              IsEditable="True"
                              MinWidth="130" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="외국어" FontSize="13" />
                        <TextBlock Text="주로 학습하거나 번역할 대상 언어" FontSize="10" Opacity="0.5" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding ForeignLanguage}"
                              IsEditable="True"
                              MinWidth="130" />
                </Grid>
            </ui:Card>

            <TextBlock Text="입력 설정" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12" />

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="글로벌 단축키" FontSize="13" />
                        <TextBlock Text="어디서나 단축키로 VerbaCore를 활성화합니다" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                    <ui:TextBox Grid.Column="1"
                                Text="{Binding GlobalHotkey, Mode=TwoWay}"
                                MinWidth="120"
                                PlaceholderText="Ctrl+Alt+V" />
                </Grid>
            </ui:Card>

            <!-- Appearance -->
            <TextBlock Text="외관" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12" />

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="테마" VerticalAlignment="Center" FontSize="13" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableThemes}"
                              SelectedItem="{Binding SelectedTheme}"
                              MinWidth="100" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="검색창 위치" FontSize="13" />
                        <TextBlock Text="검색창이 화면에 표시되는 위치" FontSize="10" Opacity="0.5" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailablePositions}"
                              SelectedItem="{Binding PopupPosition}"
                              MinWidth="120" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="검색창 크기" FontSize="13" />
                        <TextBlock Text="검색창의 기본 크기를 선택합니다" FontSize="10" Opacity="0.5" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableSizes}"
                              SelectedItem="{Binding OverlaySize}"
                              MinWidth="100" />
                </Grid>
            </ui:Card>

            <!-- System -->
            <TextBlock Text="시스템" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12" />

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Windows 시작 시 실행" FontSize="13" />
                        <TextBlock Text="컴퓨터 시작 시 VerbaCore를 자동 실행합니다" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1"
                                     IsChecked="{Binding StartWithWindows}" />
                </Grid>
            </ui:Card>

            <!-- Save Button -->
            <ui:Button Content="설정 저장"
                       Appearance="Primary"
                       Command="{Binding SaveSettingsCommand}"
                       HorizontalAlignment="Stretch"
                       FontSize="14"
                       Padding="0,10"
                       Margin="0,16,0,0" />

            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="Green"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>