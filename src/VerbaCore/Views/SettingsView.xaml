<UserControl x:Class="VerbaCore.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:VerbaCore.ViewModels"
             xmlns:helpers="clr-namespace:VerbaCore.Helpers"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="16,8,16,16">
        <StackPanel Margin="0,0,0,16">

            <!-- API Settings -->
            <TextBlock Text="{DynamicResource Settings_ApiSection}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

            <ui:Card Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_ApiProvider}" Margin="0,0,0,4" FontSize="12" Opacity="0.7" />
                    <ComboBox ItemsSource="{Binding AvailableProviders}"
                              SelectedItem="{Binding SelectedProvider}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,8" Visibility="{Binding ShowProtocol, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_ApiProtocol}" Margin="0,0,0,4" FontSize="12" Opacity="0.7" />
                    <ComboBox ItemsSource="{Binding AvailableProtocols}" DisplayMemberPath="Value" SelectedValuePath="Key"
                              SelectedValue="{Binding Protocol}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="API Key" Margin="0,0,0,4" FontSize="12" Opacity="0.7" />
                    <ui:PasswordBox Password="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{Binding IsAzure, Converter={StaticResource BoolToAzureKeyPlaceholderConverter}}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Margin="0,0,0,4" FontSize="12" Opacity="0.7"
                               Text="{DynamicResource Settings_Model}"
                               Visibility="{Binding IsAzure, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                    <TextBlock Margin="0,0,0,4" FontSize="12" Opacity="0.7"
                               Text="{DynamicResource Settings_ModelAzure}"
                               Visibility="{Binding IsAzure, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ComboBox ItemsSource="{Binding AvailableModels}"
                              IsEditable="True"
                              Text="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock FontSize="10" Opacity="0.5" Margin="0,4,0,0"
                               Text="{DynamicResource Settings_ModelHint}"
                               Visibility="{Binding IsAzure, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                    <TextBlock FontSize="10" Opacity="0.5" Margin="0,4,0,0"
                               Text="{DynamicResource Settings_ModelAzureHint}"
                               Visibility="{Binding IsAzure, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </ui:Card>

            <!-- Azure OpenAI Settings -->
            <StackPanel Visibility="{Binding IsAzure, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:Card Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_AzureEndpoint}" Margin="0,0,0,4" FontSize="12" Opacity="0.7" />
                        <ui:TextBox Text="{Binding AzureEndpoint, Mode=TwoWay}"
                                    PlaceholderText="{Binding AzureEndpointPlaceholder}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,8" Visibility="{Binding IsLegacyAzure, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_AzureApiVersion}" Margin="0,0,0,4" FontSize="12" Opacity="0.7" />
                        <ui:TextBox Text="{Binding AzureApiVersion, Mode=TwoWay}"
                                    PlaceholderText="2024-10-21" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <!-- Custom Endpoint Settings -->
            <StackPanel Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:Card Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_CustomEndpoint}" Margin="0,0,0,4" FontSize="12" Opacity="0.7" />
                        <ui:TextBox Text="{Binding CustomEndpoint, Mode=TwoWay}"
                                    PlaceholderText="{DynamicResource Settings_CustomEndpointPlaceholder}" />
                        <TextBlock Text="{DynamicResource Settings_CustomEndpointHint}" FontSize="10" Opacity="0.5" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <Expander Header="{DynamicResource Settings_RequestOptions}" Margin="0,4,0,12" IsExpanded="False">
                <StackPanel Margin="0,8,0,0">
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsMessages, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <TextBlock Text="{DynamicResource Settings_InstructionRole}" FontSize="12" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableInstructionRoles}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding SelectedInstructionRole}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsMessages, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <TextBlock Text="{DynamicResource Settings_TokenParameter}" FontSize="12" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableTokenParameters}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding TokenLimitParameter}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding ShowTokenLimit, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Settings_MaxOutputTokens}" FontSize="12" Margin="0,0,0,4" />
                        <ui:NumberBox Value="{Binding MaxOutputTokens, Mode=TwoWay}" Minimum="1" Maximum="1048576" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Settings_ReasoningMode}" FontSize="12" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding AvailableReasoningModes}" DisplayMemberPath="Value" SelectedValuePath="Key"
                              SelectedValue="{Binding SelectedReasoningMode}" Margin="0,0,0,12" />
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding ShowReasoningEffort, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Settings_ReasoningEffort}" FontSize="12" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableReasoningEfforts}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding ReasoningEffort}" ToolTip="{DynamicResource Settings_ReasoningEffortHint}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding ShowThinkingBudget, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Settings_ThinkingBudget}" FontSize="12" Margin="0,0,0,4" />
                        <ui:NumberBox Value="{Binding ThinkingBudgetTokens, Mode=TwoWay}" Minimum="1024" Maximum="1048575" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- Input Settings -->
            <TextBlock Text="{DynamicResource Settings_LanguageSection}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12" />

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Settings_NativeLanguage}" FontSize="13" />
                        <TextBlock Text="{DynamicResource Settings_NativeLanguageHint}" FontSize="10" Opacity="0.5" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding NativeLanguage}"
                              IsEditable="True"
                              MinWidth="130" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Settings_ForeignLanguage}" FontSize="13" />
                        <TextBlock Text="{DynamicResource Settings_ForeignLanguageHint}" FontSize="10" Opacity="0.5" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding ForeignLanguage}"
                              IsEditable="True"
                              MinWidth="130" />
                </Grid>
            </ui:Card>

            <TextBlock Text="{DynamicResource Settings_InputSection}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12" />

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Settings_GlobalHotkey}" FontSize="13" />
                        <TextBlock Text="{DynamicResource Settings_GlobalHotkeyHint}" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                    <ui:TextBox Grid.Column="1"
                                Text="{Binding GlobalHotkey, Mode=TwoWay}"
                                MinWidth="120"
                                PlaceholderText="Ctrl+Alt+V" />
                </Grid>
            </ui:Card>

            <!-- Appearance -->
            <TextBlock Text="{DynamicResource Settings_AppearanceSection}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12" />

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource Settings_Theme}" VerticalAlignment="Center" FontSize="13" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableThemes}"
                              SelectedItem="{Binding SelectedTheme}"
                              MinWidth="100" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Settings_UiLanguage}" FontSize="13" />
                        <TextBlock Text="{DynamicResource Settings_UiLanguageHint}" FontSize="10" Opacity="0.5" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableUiLanguages}"
                              SelectedItem="{Binding SelectedUiLanguage}"
                              MinWidth="100" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Settings_OverlayPosition}" FontSize="13" />
                        <TextBlock Text="{DynamicResource Settings_OverlayPositionHint}" FontSize="10" Opacity="0.5" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailablePositions}"
                              SelectedItem="{Binding PopupPosition}"
                              MinWidth="120" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Settings_OverlaySize}" FontSize="13" />
                        <TextBlock Text="{DynamicResource Settings_OverlaySizeHint}" FontSize="10" Opacity="0.5" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableSizes}"
                              SelectedItem="{Binding OverlaySize}"
                              MinWidth="100" />
                </Grid>
            </ui:Card>

            <!-- System -->
            <TextBlock Text="{DynamicResource Settings_SystemSection}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12" />

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Settings_StartWithWindows}" FontSize="13" />
                        <TextBlock Text="{DynamicResource Settings_StartWithWindowsHint}" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1"
                                     IsChecked="{Binding StartWithWindows}" />
                </Grid>
            </ui:Card>

            <!-- Update -->
            <TextBlock Text="{DynamicResource Settings_UpdateSection}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12" />

            <ui:Card Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings_AutoCheckUpdate}" FontSize="13" />
                            <TextBlock Text="{DynamicResource Settings_AutoCheckUpdateHint}" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding AutoCheckUpdate}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.7">
                            <Run Text="{DynamicResource Settings_CurrentVersion}" />
                            <Run Text=" " />
                            <Run Text="{Binding CurrentVersion, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <ui:Button Grid.Column="1"
                                   Content="{DynamicResource Settings_CheckUpdateButton}"
                                   Command="{Binding CheckForUpdatesCommand}"
                                   IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBoolConverter}}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Cache -->
            <TextBlock Text="{DynamicResource Settings_CacheSection}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12" />

            <ui:Card Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings_EnableCache}" FontSize="13" />
                            <TextBlock Text="{DynamicResource Settings_EnableCacheHint}" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding EnableLookupCache}" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Settings_CacheTtlDays}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                        <ui:NumberBox Grid.Column="1"
                                      Value="{Binding CacheTtlDays}"
                                      Minimum="1"
                                      Maximum="365" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.7">
                            <Run Text="{DynamicResource Settings_CacheEntryCount}" />
                            <Run Text=" " />
                            <Run Text="{Binding CacheEntryCount, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <ui:Button Grid.Column="1"
                                   Content="{DynamicResource Settings_ClearCache}"
                                   Command="{Binding ClearCacheCommand}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>

        <!-- Sticky Save Button -->
        <Border Grid.Row="1" Padding="16,8,16,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <StackPanel>
                <ui:Button Content="{DynamicResource Settings_SaveButton}"
                           Appearance="Primary"
                           Command="{Binding SaveSettingsCommand}"
                           HorizontalAlignment="Stretch"
                           FontSize="14"
                           Padding="0,10" />

                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="Green"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>