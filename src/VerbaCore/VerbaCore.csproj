<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>VerbaCore</AssemblyName>
    <RootNamespace>VerbaCore</RootNamespace>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\res\icons\verbacore.ico</ApplicationIcon>

    <!-- Product metadata -->
    <Product>VerbaCore</Product>
    <Description>AI-powered dictionary, translator and grammar analyzer</Description>
    <Copyright>Copyright © VerbaCore 2025-2026</Copyright>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="NHotkey.Wpf" Version="4.0.0" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed icons into the assembly so they survive single-file publish and installer packaging. -->
    <Resource Include="..\..\res\icons\verbacore.ico" Link="res\icons\verbacore.ico" />
    <Resource Include="..\..\res\icons\verbacore.png" Link="res\icons\verbacore.png" />
  </ItemGroup>

</Project>
